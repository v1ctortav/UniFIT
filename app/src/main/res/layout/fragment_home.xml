<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cliente.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_circulo"
            android:clipToOutline="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/bg_user_image"
            tools:src="@drawable/bg_user_image" />

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/imageView3"
            app:layout_constraintStart_toEndOf="@+id/imageView3"
            app:layout_constraintTop_toTopOf="@+id/imageView3">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Olá,"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/name_text_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Usuário!"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/linearLayout3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/linearLayout3">

            <ImageButton
                android:id="@+id/btn_go_to_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/light_gray"
                android:padding="8dp"
                android:src="@drawable/ic_notifications"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/notifications_count_text"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/unifor"
                android:gravity="center"
                tools:text="0"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="Treino do dia"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <include
                        android:id="@+id/treinodia_card"
                        layout="@layout/card_treino_item"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textView11" />

                    <TextView
                        android:id="@+id/textView9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="24dp"
                        android:text="Sugestões"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/treinodia_card" />

                    <LinearLayout
                        android:id="@+id/linearLayout4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="16dp"
                        android:divider="@drawable/horizontal_divider"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:showDividers="middle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView9">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_go_to_execucoes_acess"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_arredondado"
                                android:backgroundTint="@color/light_gray"
                                android:src="@drawable/ic_fitness_center"
                                android:tint="@color/black" />

                            <TextView
                                android:id="@+id/textView10"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Execuções"
                                android:textAlignment="center"
                                android:textSize="16sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_go_to_progresso_acess"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_arredondado"
                                android:backgroundTint="@color/light_gray"
                                android:src="@drawable/ic_military_tech" />

                            <TextView
                                android:id="@+id/textView13"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Progresso"
                                android:textAlignment="center"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_go_to_plano_acess"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_arredondado"
                                android:backgroundTint="@color/light_gray"
                                android:src="@drawable/ic_account_balance_wallet" />

                            <TextView
                                android:id="@+id/textView14"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Plano"
                                android:textAlignment="center"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_go_to_ajuda_acess"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_arredondado"
                                android:backgroundTint="@color/light_gray"
                                android:src="@drawable/ic_support_agent" />

                            <TextView
                                android:id="@+id/textView15"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Ajuda"
                                android:textAlignment="center"
                                android:textSize="16sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textView16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="24dp"
                        android:text="Encontre o melhor treino"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout4" />

                    <TextView
                        android:id="@+id/link_go_to_treino_library"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="32dp"
                        android:text="Ver todos"
                        android:textColor="@color/unifor"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/textView16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/textView16" />

                    <HorizontalScrollView
                        android:id="@+id/horizontalScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="32dp"
                        android:scrollbarAlwaysDrawVerticalTrack="false"
                        android:scrollbars="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textView16">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:divider="@drawable/vertical_divider"
                            android:orientation="horizontal"
                            android:showDividers="middle">

                            <Button
                                android:id="@+id/btn_toggle_todos_view_itens_treino_lista_main"
                                android:layout_width="100dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_arredondado"
                                android:text="Todos"
                                android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                                android:textSize="16sp"
                                app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                            <Button
                                android:id="@+id/btn_toggle_peito_view_itens_treino_lista_main"
                                android:layout_width="100dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_arredondado"
                                android:text="Peito"
                                android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                                android:textSize="16sp"
                                app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                            <Button
                                android:id="@+id/btn_toggle_costas_view_itens_treino_lista_main"
                                android:layout_width="100dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_arredondado"
                                android:text="Costas"
                                android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                                android:textSize="16sp"
                                app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                            <Button
                                android:id="@+id/btn_toggle_ombro_view_itens_treino_lista_main"
                                android:layout_width="100dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_arredondado"
                                android:text="Ombro"
                                android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                                android:textSize="16sp"
                                app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                            <Button
                                android:id="@+id/btn_toggle_pernas_view_itens_treino_lista_main"
                                android:layout_width="100dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_arredondado"
                                android:text="Pernas"
                                android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                                android:textSize="16sp"
                                app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_list_treinos_main"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="32dp"
                        android:layout_marginBottom="24dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView"
                        tools:itemCount="10"
                        tools:listitem="@layout/card2_treino_item" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>