<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_arredondado"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/img_notification_item"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circulo"
        android:backgroundTint="@color/light_gray"
        android:clipToOutline="true"
        android:foregroundTint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_not_found_background_ic" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/img_notification_item"
        app:layout_constraintStart_toEndOf="@+id/img_notification_item"
        app:layout_constraintTop_toTopOf="@+id/img_notification_item">

        <TextView
            android:id="@+id/text_name_notification_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notificação"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_desc_notification_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição da notificação" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_time_notification_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Há 0 minutos"
        android:textColor="@color/gray"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/new_alert_notification_item"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_circulo"
        android:backgroundTint="@color/unifor"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>