<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/imageView31"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_circulo"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_user_image" />

    <TextView
        android:id="@+id/textView163"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Nome do aluno"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView31"
        app:layout_constraintStart_toEndOf="@+id/imageView31"
        app:layout_constraintTop_toTopOf="@+id/imageView31" />

    <View
        android:id="@+id/view13"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_circulo"
        android:backgroundTint="#8DE27C"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="@+id/imageView31"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/imageView31"
        app:layout_constraintTop_toTopOf="@+id/imageView31" />

    <ImageButton
        android:id="@+id/btn_menu_aluno"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="24dp"
        android:background="@color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/btn_ir_chat_aluno"
        app:layout_constraintEnd_toStartOf="@+id/btn_ir_chat_aluno"
        app:layout_constraintTop_toTopOf="@+id/btn_ir_chat_aluno"
        app:srcCompat="@drawable/ic_menu" />

    <ImageButton
        android:id="@+id/btn_ir_chat_aluno"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/imageView31"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView31"
        app:srcCompat="@drawable/ic_chat" />

    <View
        android:id="@+id/view14"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_circulo"
        android:backgroundTint="@color/unifor"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/btn_ir_chat_aluno"
        app:layout_constraintEnd_toEndOf="@+id/btn_ir_chat_aluno"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/btn_ir_chat_aluno" />

    <View
        android:id="@+id/view15"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_arredondado"
        android:backgroundTint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView31" />
</androidx.constraintlayout.widget.ConstraintLayout>