<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cliente.treino.TreinosBibliotecaFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView105"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:text="Treinos"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btn_voltar_treinos_biblioteca_treinos"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="60dp"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"
                android:src="@drawable/arrow_back"
                android:tint="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btn_pesquisar_treino"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="60dp"
                android:layout_marginEnd="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_search"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_pesquisa_treino"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_arredondado"
                android:backgroundTint="@color/light_gray"
                android:visibility="gone"
                app:boxBackgroundMode="none"
                app:expandedHintEnabled="false"
                app:hintAnimationEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView105">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_search"
                    android:drawableTint="@color/gray"
                    android:hint="Pesquisar" />
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/textView106"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:text="Encontre o melhor treino"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout10" />

        <HorizontalScrollView
            android:id="@+id/horizontalScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:scrollbarAlwaysDrawVerticalTrack="false"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView106">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:divider="@drawable/vertical_divider"
                android:orientation="horizontal"
                android:showDividers="middle">

                <Button
                    android:id="@+id/btn_toggle_todos_view_itens_treino_lista_treinos"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arredondado"
                    android:text="Todos"
                    android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                    android:textSize="16sp"
                    app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                <Button
                    android:id="@+id/btn_toggle_peito_view_itens_treino_lista_treinos"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arredondado"
                    android:text="Peito"
                    android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                    android:textSize="16sp"
                    app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                <Button
                    android:id="@+id/btn_toggle_costas_view_itens_treino_lista_treinos"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arredondado"
                    android:text="Costas"
                    android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                    android:textSize="16sp"
                    app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                <Button
                    android:id="@+id/btn_toggle_ombro_view_itens_treino_lista_treinos"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arredondado"
                    android:text="Ombro"
                    android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                    android:textSize="16sp"
                    app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

                <Button
                    android:id="@+id/btn_toggle_pernas_view_itens_treino_lista_treinos"
                    android:layout_width="100dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_arredondado"
                    android:text="Pernas"
                    android:textColor="@color/text_tint_toggle_itens_treinos_list_main_item_selected"
                    android:textSize="16sp"
                    app:backgroundTint="@color/bg_toggle_itens_treinos_list_main_item_selected" />

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cards_treinos_biblioteca"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView"
            tools:itemCount="12"
            tools:listitem="@layout/card_treino_item" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>